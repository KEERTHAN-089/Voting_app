# Copy this file to .env and fill in the values.

# MongoDB connection string. Voting uses transactions, which need a replica set:
# MongoDB Atlas works as-is; a plain local mongod does not.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/voting_app

# Any long random string. Signs login tokens and protects sign-in codes.
JWT_SECRET=change-me-to-a-long-random-string

PORT=3000
NODE_ENV=development

# Email for sign-in codes. Until SMTP_HOST, SMTP_USER and SMTP_PASS are all
# filled in, the code is printed in the server console instead of being emailed.
# Use a mailbox created for the app, not a personal one: every code is sent from it.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=the-app-mailbox@gmail.com,
# SMTP_PASS=an app password from https://myaccount.google.com/apppasswords
# (not the account's normal password). Check the settings with: npm run test-email -- you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. Emails are sent as "Voting App <SMTP_USER>" unless this is set.
# MAIL_FROM=Class Elections <the-app-mailbox@gmail.com>

# Optional. How alike two faces must be in face-match sessions (lower is stricter).
# FACE_MATCH_THRESHOLD=0.5
