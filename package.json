{
  "name": "voting-app",
  "version": "2.0.0",
  "description": "Create and run voting sessions for classes, clubs and teams",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "demo": "concurrently \"cd backend && npm run demo\" \"npm run client\"",
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": "cd frontend && npm run build",
    "test": "cd backend && npm test",
    "azure:setup": "node deploy/azure.js setup",
    "azure:deploy": "node deploy/azure.js deploy",
    "azure:package": "node deploy/azure.js package"
  },
  "dependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "voting",
    "election",
    "mern",
    "react",
    "node",
    "mongodb"
  ],
  "author": "",
  "license": "ISC"
}
